# Normalize line endings so the project works when cloned on Windows/macOS/Linux.
* text=auto

# Shell scripts MUST stay LF, or bash fails with "bash\r: not found".
*.sh   text eol=lf

# PowerShell scripts are happiest with CRLF on Windows (PS 5.1).
*.ps1  text eol=crlf

# Python / data / docs: LF everywhere (Python reads both anyway).
*.py   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
